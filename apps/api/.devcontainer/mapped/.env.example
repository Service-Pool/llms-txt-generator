APP_MODE=development

# Docker
COMPOSE_PROJECT_NAME=llms-generator-api

# Frontend server port (development & production)
PORT=4200

# AI Providers
# Gemini модели (рекомендуются для production):
# - gemini-2.5-flash-lite - стабильная fast модель
# - gemini-2.5-flash - новейшая стабильная fast модель
# - gemini-2.5-pro - новейшая стабильная pro модель
# - gemini-flash-latest - алиас на последнюю flash версию
# - gemini-pro-latest - алиас на последнюю pro версию
#
# Gemma модели (через Gemini API):
# - gemma-3-1b-it - 1B параметров
# - gemma-3-4b-it - 4B параметров
# - gemma-3-12b-it - 12B параметров ← вам нужна эта
# - gemma-3-27b-it - 27B параметров

# AI Providers
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MEMORY_LIMIT=2G
OLLAMA_MODEL=gemma2:2b
GEMINI_API_KEY=
GEMINI_25_FLASH_LIGHT_MODEL=gemini-2.5-flash-lite
GEMINI_31_FLASH_LIGHT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_BATCH_SIZE=100
CRAWL_CONCURRENCY=10

# Models Configuration (JSON array)
MODELS_CONFIG='[
	{
		"id": "gemini-2.5-flash-lite",
		"enabled": true,
		"category": "Free",
		"displayName": "Gemini 2.5 Flash Light",
		"description": "Free, high-quality AI model from Google",
		"serviceClass": "./models/gemini.service",
		"modelName": "GEMINI_25_FLASH_LIGHT_MODEL",
		"baseRate": 0.00,
		"pageLimit": 5000,
		"queueName": "gemini-queue",
		"queueType": "cloud",
		"options": {
			"apiKey": "GEMINI_API_KEY",
			"temperature": 0.5,
			"maxTokens": 8192,
			"maxLlmConcurrency": 3,
			"maxSummaryBatchSize": 20
		}
	},
	{
		"id": "gemini-3.1-flash-lite",
		"enabled": true,
		"category": "Stable",
		"displayName": "Gemini 3.1 Flash Light",
		"description": "Stable, high-quality AI model from Google",
		"serviceClass": "./models/gemini.service",
		"modelName": "GEMINI_31_FLASH_LIGHT_MODEL",
		"baseRate": 0.00015,
		"pageLimit": false,
		"queueName": "gemini-queue",
		"queueType": "cloud",
		"options": {
			"apiKey": "GEMINI_API_KEY",
			"temperature": 0.5,
			"maxTokens": 8192,
			"maxLlmConcurrency": null,
			"maxSummaryBatchSize": 50
		}
	},
	{
		"id": "ollama-local",
		"enabled": false,
		"category": "Free",
		"displayName": "Qwen 2.5 (Local)",
		"description": "Free local model, slower but cost-effective",
		"serviceClass": "./models/ollama.service",
		"modelName": "OLLAMA_MODEL",
		"baseRate": 0.00,
		"pageLimit": false,
		"queueName": "ollama-queue",
		"queueType": "local",
		"options": {
			"baseUrl": "http://OLLAMA_HOST:OLLAMA_PORT",
			"temperature": 0.5,
			"maxTokens": 2048,
			"maxLlmConcurrency": 3,
			"maxSummaryBatchSize": 2
		}
	}
]'

# Queue Configuration (JSON array)
QUEUES_CONFIG='[
	{
		"name": "gemini-queue",
		"type": "cloud",
		"concurrency": 3,
		"lockDuration": 30000,
		"stalledInterval": 30000
	},
	{
		"name": "ollama-queue",
		"type": "local",
		"concurrency": 1,
		"lockDuration": 30000,
		"stalledInterval": 30000
	}
]'

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MIN_PAYMENT=0.50
STRIPE_CURRENCY=EUR

# Allowed domains for CORS and redirect URLs (comma-separated or '*' for public API)
ALLOWED_DOMAINS=http://localhost:6060

# SMTP (для magic link авторизации)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_PASSWORD=

# Magic Link
LOGIN_LINK_EXPIRY_MINUTES=15

# Database
DB_ROOT_PASSWORD=
DB_HOST=mysql
DB_PORT=3306
DB_NAME=llms-txt-generator-api
DB_USER=
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_INSIGHT_HOST=redisinsight
REDIS_INSIGHT_PORT=8001

# Session
SESSION_COOKIE_NAME=llmstxt.sid
SESSION_SECRET=
SESSION_MAX_AGE=86400000

SOCKET_PATH="/ws"

AES_KEY=
AES_IV=

THROTTLE_TTL=60
THROTTLE_LIMIT=10
